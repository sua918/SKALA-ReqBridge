{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DocumentAnalysisResult",
  "description": "ReqBridge LLM 문서 분석 결과 스키마 (schemaVersion: 1.0.0)",
  "type": "object",
  "required": ["requirements"],
  "properties": {
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["sequenceNo", "originalText", "issues"],
        "properties": {
          "sequenceNo": {
            "type": "integer",
            "minimum": 1,
            "description": "문서 내 요구사항 순번 (1부터 시작하는 고유 정수)"
          },
          "originalText": {
            "type": "string",
            "minLength": 1,
            "description": "추출된 요구사항 원문"
          },
          "issues": {
            "type": "array",
            "description": "발견된 불명확성 이슈 목록 (명확한 경우 빈 배열)",
            "items": {
              "type": "object",
              "required": ["type", "evidence", "questionText"],
              "properties": {
                "type": {
                  "type": "string",
                  "enum": [
                    "QUANTITY_MISSING",
                    "PERFORMANCE_MISSING",
                    "ACTOR_UNCLEAR",
                    "CONDITION_INCOMPLETE",
                    "RECOVERY_MISSING",
                    "TERMINOLOGY_INCONSISTENT"
                  ],
                  "description": "불명확성 분류"
                },
                "evidence": {
                  "type": "string",
                  "minLength": 1,
                  "description": "불명확하다고 판단한 구체적 근거"
                },
                "questionText": {
                  "type": "string",
                  "minLength": 1,
                  "description": "고객에게 전달할 명확화 질문"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
