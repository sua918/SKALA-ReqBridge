# Frontend
# 기본값은 실제 백엔드 호출이다. 백엔드 없이 화면만 볼 때만 true로 두거나
# frontend에서 `npm run dev:mock`을 사용한다.
# VITE_USE_MOCK=false

DB_HOST=localhost
DB_PORT=5432
DB_NAME=app
DB_USER=app
DB_PASSWORD=app

# Supabase profile example (do not commit the real password)
# SPRING_PROFILES_ACTIVE=supabase
# SUPABASE_DB_URL=jdbc:postgresql://db.<project-ref>.supabase.co:5432/postgres?sslmode=require
# SUPABASE_DB_USERNAME=postgres
# SUPABASE_DB_PASSWORD=<database-password>
# SUPABASE_DB_POOL_MAX_SIZE=5
