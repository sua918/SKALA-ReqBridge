# Set these in your shell or IDE environment. Spring Boot does not load .env automatically.
SPRING_PROFILES_ACTIVE=supabase
SUPABASE_DB_URL=jdbc:postgresql://YOUR_SESSION_POOLER_HOST:5432/postgres?sslmode=require
SUPABASE_DB_USERNAME=postgres.YOUR_PROJECT_REF
SUPABASE_DB_PASSWORD=REPLACE_LOCALLY

# Private Storage bucket must be created separately. Never use a publishable key here.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_STORAGE_BUCKET=reqbridge-documents
SUPABASE_SERVICE_ROLE_KEY=REPLACE_LOCALLY_WITH_SERVER_ONLY_SERVICE_ROLE_KEY
